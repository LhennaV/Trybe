# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Production values live in Vercel environment variables (TRD section 17).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never use it in src/components or a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Connect > ORMs (or Connection string)
# Transaction pooler, port 6543. Used by the app and serverless functions.
DATABASE_URL=
# Direct connection (or session pooler, port 5432). Used by drizzle-kit migrations.
DIRECT_DATABASE_URL=

# Cloudflare > Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry > Project Settings > Client Keys (DSN). Leave empty to turn Sentry off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps. Set these in Vercel, not locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
